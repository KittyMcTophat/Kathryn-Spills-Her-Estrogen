[sub_resource type="GDScript" id="GDScript_8avll"]
script/source = "extends Node

@export_file(\"*.tscn\") var next_scene : String = \"\";
@export var dialogue : Dialogue = null;

func _ready():
	Global.estrogen_counter.estrogen_changed.connect(_estrogen_count_changed);

func _estrogen_count_changed(value : int):
	if Global.estrogen_counter.max_estrogen == value:
		Global.textbox.start_dialogue(dialogue);
		await Global.textbox.dialogue_finished;
		Global.fade_to_scene_path(next_scene);
"

