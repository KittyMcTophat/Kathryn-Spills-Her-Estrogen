[sub_resource type="GDScript" id="GDScript_rmjpr"]
script/source = "extends Node

@export var dialogue : Dialogue = null;

static var showed_dialogue : bool = false;

func _process(_delta):
	if !showed_dialogue:
		Global.textbox.start_dialogue(dialogue);
		showed_dialogue = true;
	queue_free();
"

