[sub_resource type="Resource" id="Resource_fw658"]
script = ExtResource("1_why4g")
text_sequence = Array[String](["[Press Space/Enter/A Button to Advance The Text]", "Kathryn:
Oh shit!", "Kathryn:
I spilled my estrogen all over the place!", "Kathryn:
Now I have to pick it up!", "Kathryn:
Also I ended up in [wave][rainbow]space[/rainbow][/wave] somehow?!", "Kathryn:
...There's a lot more garbage in space than I thought.", "Kathryn:
...
I'm gonna have to figure out how to get home later.", "Kathryn:
For now I'll  just focus on picking up all my estrogen..."])

