script/source = "@tool
extends HFlowContainer

signal costume_selected();

@export var costumes_array : Array[Costume] = []:
	set(value):
		costumes_array = value;
		update_children();

func update_children():
	for child in get_children():
		child.queue_free();
	
	for costume in costumes_array:
		add_costume(costume);
	
	load_custom_costumes();

func load_custom_costumes():
	var custom_costumes_dir_path : String = OS.get_executable_path().get_base_dir() + \"/Custom/Costumes\";
	print(\"Attempting to load custom costumes from: \", custom_costumes_dir_path)
	if !DirAccess.dir_exists_absolute(custom_costumes_dir_path):
		print(\"Directory does not exist, costumes not loaded\");
		return;
	print(\"Directory Found\");
	var custom_costumes_dir : DirAccess = DirAccess.open(custom_costumes_dir_path);
	print(\"Contents: \", custom_costumes_dir.get_files());
	for file in custom_costumes_dir.get_files():
		# Only loading the jsons right now
		if file.get_extension() != \"json\":
			continue;
		print(\"\\nLoading json: \", file);
		
		var file_acess : FileAccess = FileAccess.open(custom_costumes_dir_path + \"/\" + file, FileAccess.READ);
		if file_acess == null:
			print(\"Open file failed: \", file_acess.get_error());
			continue;
		print(file_acess.get_as_text());
		
		var json_data = JSON.parse_string(file_acess.get_as_text());
		if json_data == null:
			print(\"Malformed JSON\");
			continue;
		
		if json_data is Array:
			for item in json_data:
				if item is Dictionary:
					load_costume_from_dictionary(item, custom_costumes_dir_path);
		else:
			if json_data is Dictionary:
				load_costume_from_dictionary(json_data, custom_costumes_dir_path);

func load_costume_from_dictionary(dict : Dictionary, image_find_base_dir : String):
	print(\"Loading costume data: \", dict);
	var new_costume : Costume = Costume.new();
	
	if !dict.has(\"name\"):
		print(\"\\\"name\\\" key not found, load failed\");
		return;
	if !dict.name is String:
		print(\"\\\"name\\\" key corresponding value is not a string, load failed\");
		return;
	new_costume.name = dict.name;
	
	if !dict.has(\"texture\"):
		print(\"\\\"texture\\\" key not found, load failed\");
		return;
	if !dict.texture is String:
		print(\"\\\"texture\\\" key corresponding value is not a string, load failed\");
		return;
	var file_path : String = image_find_base_dir + \"/\" + dict.texture;
	if FileAccess.file_exists(file_path):
		var image : Image = Image.load_from_file(file_path);
		var texture : ImageTexture = ImageTexture.create_from_image(image);
		new_costume.texture = texture;
	else:
		print(file_path, \" does not exist\");
	
	if !dict.has(\"icon_crop_rect\"):
		print(\"\\\"icon_crop_rect\\\" key not found, load failed\");
		return;
	if !dict.icon_crop_rect is Array:
		print(\"\\\"icon_crop_rect\\\" key corresponding value is not an array, load failed\");
		return;
	if dict.icon_crop_rect.size() != 4:
		print(\"\\\"icon_crop_rect\\\" array wrong size. Should be 4 elements. Load failed\")
		return;
	for i in range(4):
		if dict.icon_crop_rect[i] < 0:
			print(\"\\\"icon_crop_rect\\\" array contains negative elements. Load failed\");
			return;
	var arr : Array = dict.icon_crop_rect;
	var crop_rect : Rect2i = Rect2i(arr[0], arr[1], arr[2], arr[3]);
	new_costume.crop_rect = crop_rect;
	
	add_costume(new_costume);

func add_costume(costume : Costume):
	var costume_button : CostumeButton = preload(\"res://UI/Costume Select/costume_button.tscn\").instantiate();
	add_child(costume_button);
	costume_button.costume = costume;
	costume_button.costume_picked.connect(self.emit_signal.bind(\"costume_selected\"));

func _ready():
	if Engine.is_editor_hint():
		return;
	find_next_valid_focus().grab_focus();
"

