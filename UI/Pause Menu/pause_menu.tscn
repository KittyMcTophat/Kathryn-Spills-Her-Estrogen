[sub_resource type="GDScript" id="GDScript_n6gep"]
script/source = "extends BetterButton

var enabled : bool = true;

func _ready():
	super._ready();
	enabled = (DisplayServer.window_get_vsync_mode() == DisplayServer.VSYNC_ENABLED);
	update_text();

func _pressed():
	enabled = !enabled;
	if enabled:
		DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED);
	else:
		DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED);
	update_text();

func update_text():
	text = \"V-Sync: \" + (\"Enabled\" if enabled else \"Disabled\");
	Log.print_info(text);
"

[sub_resource type="GDScript" id="GDScript_tjihy"]
script/source = "extends BetterButton

func _ready():
	super._ready();
	
	if !OS.has_feature(\"pc\"):
		queue_free();
	Global.window_mode_changed.connect(window_mode_changed.unbind(1));
	
	update_text();

func window_mode_changed():
	update_text();

func _pressed():
	if !is_fullscreen():
		Global.set_window_mode(DisplayServer.WINDOW_MODE_FULLSCREEN);
	else:
		Global.set_window_mode(DisplayServer.WINDOW_MODE_WINDOWED);

func update_text():
	text = \"Fullscreen: \" + (\"Enabled\" if is_fullscreen() else \"Disabled\");
	Log.print_info(text);

func is_fullscreen() -> bool:
	return (DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN);
"

